# Copy to .env.local and fill in — .env.local is gitignored and never committed.

# Turso: the database URL and a token with write access.
# From the Turso dashboard, or: turso db show <name> --url / turso db tokens create <name>
TURSO_DATABASE_URL=libsql://<your-database>.turso.io
TURSO_AUTH_TOKEN=

# Signs the session cookie. Must be set in production — the app refuses to
# verify sessions against its built-in dev fallback when NODE_ENV=production.
# A freshly generated one you can use:
SESSION_SECRET=XWko5dYsxPzyDPhlo2uWO11oYfwYs5ojLCSKXVtGwF7BITvT
